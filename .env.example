# Copy to .env and fill in. Never commit .env.
# Only these three variables are read from .env; anything else in it is ignored.
ANTHROPIC_API_KEY=
# Optional: override the extraction model (default claude-haiku-4-5-20251001)
CV_SCREEN_MODEL=
# Set to 1 to run offline with the rule-based mock extractor
MOCK_LLM=0
